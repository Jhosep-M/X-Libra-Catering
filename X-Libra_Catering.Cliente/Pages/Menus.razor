@page "/menus"
@inject ServicioMenu ServMenu
@inject NavigationManager ServNav

<PageTitle>Menus</PageTitle>

<h3>Listado de Menus</h3>

<p>
    <a href="menu" class="btn btn-primary">Agregar</a>
</p>

<table class="table" align="center" width="80%" border="1">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Descripcion</th>
            <th>Categoria</th>
            <th>Precio</th>
            <th>Refrigeracion</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in lista)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nombre</td>
                <td>@item.Descripcion</td>
                <td>@item.Categoria</td>
                <td>@item.Precio.ToString("C")</td>
                <td>@(item.RequiereRefrigeracion ? "Si" : "No")</td>
                <td>
                    <a href="menu/@item.Id" class="btn btn-sm btn-warning">Modificar</a>
                    <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(item.Id)">Eliminar</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<MenuDTO> lista = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarLista();
    }

    private async Task CargarLista()
    {
        try
        {
            lista = await ServMenu.Lista();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task Eliminar(int Cod)
    {
        try
        {
            await ServMenu.Eliminar(Cod);
            await CargarLista();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}
