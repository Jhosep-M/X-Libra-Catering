@page "/menu"
@page "/menu/{CodModificar:int}"
@inject ServicioMenu ServMenu
@inject NavigationManager ServNav
@inject ServicioNotificacion Notificacion

<PageTitle>@Titulo</PageTitle>

<LoadingSpinner Visible="cargando" Mensaje="Cargando datos..." />

<h3>@Titulo</h3>

@if (!string.IsNullOrEmpty(errorMensaje))
{
    <div class="alert alert-danger">@errorMensaje</div>
}

<div class="edit-form">
<EditForm Model="@dto" OnValidSubmit="@Guardar">
    <div class="form-group">
        <label>Nombre</label>
        <InputText class="form-control" @bind-Value="dto.Nombre" />
    </div>
    <div class="form-group">
        <label>Descripcion</label>
        <InputText class="form-control" @bind-Value="dto.Descripcion" />
    </div>
    <div class="form-group">
        <label>Categoria</label>
        <InputSelect class="form-select" @bind-Value="dto.Categoria">
            @foreach (var c in Enum.GetValues<CategoriaMenu>())
            {
                <option value="@c">@c</option>
            }
        </InputSelect>
    </div>
    <div class="form-group">
        <label>Precio</label>
        <InputNumber class="form-control" @bind-Value="dto.Precio" />
    </div>
    <div class="form-check">
        <InputCheckbox class="form-check-input" @bind-Value="dto.RequiereRefrigeracion" />
        <label class="form-check-label">Requiere Refrigeracion</label>
    </div>
    <div class="form-group">
        <label>Imagen del Menu</label>
        <InputFile OnChange="SeleccionarImagen" accept=".jpg,.jpeg,.png,.webp" />
        @if (!string.IsNullOrEmpty(dto.ImagenRuta))
        {
            <div style="margin-top:8px;">
                <img src="@($"{UrlHelper.Servidor}{dto.ImagenRuta}")" style="max-width:200px;max-height:150px;border-radius:var(--radius-sm);" />
            </div>
        }
    </div>
    <br />
    <button type="submit" class="btn btn-primary">@TextoBoton</button>
    <a href="menus" class="btn btn-secondary">Cancelar</a>
</EditForm>
</div>

@code {
    [Parameter]
    public int CodModificar { get; set; }

    private bool cargando;
    private MenuDTO dto = new();
    private string Titulo = "Nuevo Menu";
    private string TextoBoton = "Guardar";
    private string? errorMensaje;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        StateHasChanged();
        try
        {
            if (CodModificar > 0)
            {
                Titulo = "Modificar Menu";
                TextoBoton = "Modificar";
                dto = await ServMenu.Buscar(CodModificar);
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al cargar menu: {ex.Message}";
            Notificacion.Mostrar($"Error: {ex.Message}", ServicioNotificacion.Tipo.Error);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task SeleccionarImagen(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo == null) return;
        try
        {
            using var memoryStream = new MemoryStream();
            await archivo.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            using var streamContent = new StreamContent(memoryStream);
            var ruta = await ServMenu.SubirImagen(streamContent, archivo.Name);
            dto.ImagenRuta = ruta;
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al subir imagen: {ex.Message}";
        }
    }

    private async Task Guardar()
    {
        cargando = true;
        StateHasChanged();
        errorMensaje = null;
        try
        {
            if (CodModificar > 0)
                await ServMenu.Modificar(CodModificar, dto);
            else
                await ServMenu.Guardar(dto);
            Notificacion.Mostrar("Guardado correctamente", ServicioNotificacion.Tipo.Exito);
            ServNav.NavigateTo("menus");
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error: {ex.Message}";
            Notificacion.Mostrar($"Error: {ex.Message}", ServicioNotificacion.Tipo.Error);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
}
