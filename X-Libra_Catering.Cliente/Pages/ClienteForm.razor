@page "/cliente"
@page "/cliente/{CodModificar:int}"
@inject ServicioCliente ServCliente
@inject NavigationManager ServNav
@inject ServicioNotificacion Notificacion

<PageTitle>@Titulo</PageTitle>

<LoadingSpinner Visible="cargando" Mensaje="Cargando datos..." />

<h3>@Titulo</h3>

@if (!string.IsNullOrEmpty(errorMensaje))
{
    <div class="alert alert-danger">@errorMensaje</div>
}

<div class="edit-form">
<EditForm Model="@dto" OnValidSubmit="@Guardar">
    <div class="form-group">
        <label>Nombre</label>
        <InputText class="form-control" @bind-Value="dto.Nombre" />
    </div>
    <div class="form-group">
        <label>Telefono</label>
        <InputText class="form-control" @bind-Value="dto.Telefono" />
    </div>
    <div class="form-group">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="dto.Email" />
    </div>
    <div class="form-group">
        <label>Direccion</label>
        <InputText class="form-control" @bind-Value="dto.Direccion" />
    </div>
    <br />
    <button type="submit" class="btn btn-primary">@TextoBoton</button>
    <a href="clientes" class="btn btn-secondary">Cancelar</a>
</EditForm>
</div>

@code {
    [Parameter]
    public int CodModificar { get; set; }

    private bool cargando;
    private ClienteDTO dto = new();
    private string Titulo = "Nuevo Cliente";
    private string TextoBoton = "Guardar";
    private string? errorMensaje;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        StateHasChanged();
        try
        {
            if (CodModificar > 0)
            {
                Titulo = "Modificar Cliente";
                TextoBoton = "Modificar";
                dto = await ServCliente.Buscar(CodModificar);
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al cargar cliente: {ex.Message}";
            Notificacion.Mostrar($"Error: {ex.Message}", ServicioNotificacion.Tipo.Error);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task Guardar()
    {
        cargando = true;
        StateHasChanged();
        errorMensaje = null;
        try
        {
            if (CodModificar > 0)
                await ServCliente.Modificar(CodModificar, dto);
            else
                await ServCliente.Guardar(dto);
            Notificacion.Mostrar("Guardado correctamente", ServicioNotificacion.Tipo.Exito);
            ServNav.NavigateTo("clientes");
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error: {ex.Message}";
            Notificacion.Mostrar($"Error: {ex.Message}", ServicioNotificacion.Tipo.Error);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
}
