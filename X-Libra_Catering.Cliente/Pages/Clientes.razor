@page "/clientes"
@inject ServicioCliente ServCliente
@inject NavigationManager ServNav

<PageTitle>Clientes</PageTitle>

<h3>Listado de Clientes</h3>

<p>
    <a href="cliente" class="btn btn-primary">Agregar</a>
</p>

<table class="table" align="center" width="80%" border="1">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Telefono</th>
            <th>Email</th>
            <th>Direccion</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in lista)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nombre</td>
                <td>@item.Telefono</td>
                <td>@item.Email</td>
                <td>@item.Direccion</td>
                <td>
                    <a href="cliente/@item.Id" class="btn btn-sm btn-warning">Modificar</a>
                    <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(item.Id)">Eliminar</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<ClienteDTO> lista = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarLista();
    }

    private async Task CargarLista()
    {
        try
        {
            lista = await ServCliente.Lista();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task Eliminar(int Cod)
    {
        try
        {
            await ServCliente.Eliminar(Cod);
            await CargarLista();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}
