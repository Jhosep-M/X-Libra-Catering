@page "/eventos"
@using System.Text.Json
@inject ServicioEvento ServEvento
@inject NavigationManager ServNav

<PageTitle>Eventos - Dashboard</PageTitle>

<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h3>Eventos</h3>
            <p class="text-muted">Gestiona y da seguimiento a todos tus eventos</p>
        </div>
        <div class="header-actions">
            <a href="evento" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                </svg>
                Agregar Evento
            </a>
        </div>
    </div>

    @* ─── KPIs ─── *@
    <div class="kpi-grid">
        <div class="kpi-card kpi-total">
            <div class="kpi-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value">@kpi.TotalEventos</span>
                <span class="kpi-label">Total Eventos</span>
            </div>
        </div>
        <div class="kpi-card kpi-pending">
            <div class="kpi-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value">@kpi.Pendientes</span>
                <span class="kpi-label">Pendientes</span>
            </div>
        </div>
        <div class="kpi-card kpi-progress">
            <div class="kpi-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value">@kpi.EnPreparacion</span>
                <span class="kpi-label">En Preparacion</span>
            </div>
        </div>
        <div class="kpi-card kpi-done">
            <div class="kpi-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            </div>
            <div class="kpi-body">
                <span class="kpi-value">@kpi.CompletadosMes</span>
                <span class="kpi-label">Completados este Mes</span>
            </div>
        </div>
    </div>

    @* ─── Toolbar ─── *@
    <div class="toolbar">
        <div class="search-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" class="search-input" placeholder="Buscar por nombre o cliente..."
                   @bind="filtroTexto" @bind:event="oninput" />
        </div>
        <select class="filter-select" @bind="filtroTipo">
            <option value="">Todos los tipos</option>
            @foreach (TipoEvento t in Enum.GetValues<TipoEvento>())
            {
                <option value="@t">@t.ToString()</option>
            }
        </select>
        <span class="result-count">@eventosFiltrados.Count() eventos</span>
    </div>

    @* ─── Kanban Board ─── *@
    <div class="kanban-board">
        @foreach (var columna in columnas)
        {
            <div class="kanban-column"
                 @ondragover:preventDefault
                 @ondrop="e => SoltarEnColumna(e, columna.estado)">
                <div class="column-header">
                    <div class="column-dot @columna.color"></div>
                    <h4>@columna.titulo</h4>
                    <span class="column-count">@columna.eventos.Count()</span>
                </div>
                <div class="column-body">
                    @foreach (var ev in columna.eventos)
                    {
                        <div class="kanban-card"
                             draggable="true"
                             @ondragstart="e => ArrastrarInicio(e, ev)">
                            <div class="card-top">
                                <span class="tipo-badge tipo-@ev.TipoEvento.ToString().ToLower()">
                                    @ObtenerIconoTipo(ev.TipoEvento)
                                    @ev.TipoEvento
                                </span>
                            </div>
                            <h5 class="card-title">@ev.NombreEvento</h5>
                            <div class="card-meta">
                                <span class="meta-item">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                    @ev.ClienteNombre
                                </span>
                                <span class="meta-item">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                        <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
                                        <line x1="3" y1="10" x2="21" y2="10"/>
                                    </svg>
                                    @ev.FechaEvento.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>
                            <div class="card-meta">
                                <span class="meta-item">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                    @ev.NumInvitados invitados
                                </span>
                                <span class="meta-item">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                        <circle cx="12" cy="10" r="3"/>
                                    </svg>
                                    @ev.Ubicacion
                                </span>
                            </div>
                            <div class="card-actions">
                                <a href="evento/@ev.Id" class="btn-card-edit" title="Editar">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                </a>
                                <button class="btn-card-delete" title="Eliminar" @onclick="() => EliminarEvento(ev.Id)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"/>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                    <div class="column-dropzone">
                        <span>Arrastra una tarjeta aqui</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private DashboardKpiDTO kpi = new();
    private List<EventoDTO> todosEventos = new();
    private string? filtroTexto;
    private TipoEvento? filtroTipo;
    private EventoDTO? itemArrastrado;

    private record Columna(string titulo, EstadoEvento estado, string color, IEnumerable<EventoDTO> eventos);

    private IEnumerable<EventoDTO> eventosFiltrados => todosEventos
        .Where(e => string.IsNullOrWhiteSpace(filtroTexto) ||
                     e.NombreEvento.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
                     (e.ClienteNombre?.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(e => filtroTipo == null || e.TipoEvento == filtroTipo);

    private List<Columna> columnas => new()
    {
        new Columna("Pendientes", EstadoEvento.Pendiente, "dot-pending",
            eventosFiltrados.Where(e => e.Estado == EstadoEvento.Pendiente).OrderBy(e => e.FechaEvento)),
        new Columna("En Preparacion", EstadoEvento.EnPreparacion, "dot-progress",
            eventosFiltrados.Where(e => e.Estado == EstadoEvento.EnPreparacion).OrderBy(e => e.FechaEvento)),
        new Columna("Completados", EstadoEvento.Completado, "dot-done",
            eventosFiltrados.Where(e => e.Estado == EstadoEvento.Completado).OrderBy(e => e.FechaEvento))
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            kpi = await ServEvento.ObtenerKpi();
            todosEventos = await ServEvento.Lista();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void ArrastrarInicio(DragEventArgs e, EventoDTO ev)
    {
        itemArrastrado = ev;
    }

    private async Task SoltarEnColumna(DragEventArgs e, EstadoEvento nuevoEstado)
    {
        if (itemArrastrado != null && itemArrastrado.Estado != nuevoEstado)
        {
            try
            {
                await ServEvento.CambiarEstado(itemArrastrado.Id, nuevoEstado);
                itemArrastrado.Estado = nuevoEstado;
                await CargarDatos();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
        }
        itemArrastrado = null;
    }

    private async Task MoverAEstado(EventoDTO ev, EstadoEvento nuevoEstado)
    {
        if (ev.Estado != nuevoEstado)
        {
            try
            {
                await ServEvento.CambiarEstado(ev.Id, nuevoEstado);
                ev.Estado = nuevoEstado;
                await CargarDatos();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
        }
    }

    private async Task EliminarEvento(int id)
    {
        try
        {
            await ServEvento.Eliminar(id);
            await CargarDatos();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private string ObtenerIconoTipo(TipoEvento tipo) => tipo switch
    {
        TipoEvento.Boda => "\U0001F48D",
        TipoEvento.Corporativo => "\U0001F3E2",
        TipoEvento.Cumpleaños => "\U0001F382",
        TipoEvento.Otro => "\U0001F4CB",
        _ => "\U0001F4CB"
    };
}
