@page "/evento"
@page "/evento/{CodModificar:int}"
@inject ServicioEvento ServEvento
@inject ServicioCliente ServCliente
@inject NavigationManager ServNav
@inject ServicioNotificacion Notificacion

<PageTitle>@Titulo</PageTitle>

<LoadingSpinner Visible="cargando" Mensaje="Cargando datos..." />

<h3>@Titulo</h3>

@if (!string.IsNullOrEmpty(errorMensaje))
{
    <div class="alert alert-danger">@errorMensaje</div>
}

<div class="edit-form">
<EditForm Model="@dto" OnSubmit="@Guardar">
    <div class="form-group">
        <label>Nombre Evento</label>
        <InputText class="form-control" @bind-Value="dto.NombreEvento" />
    </div>
    <div class="form-group">
        <label>Cliente</label>
        <InputSelect class="form-select" @bind-Value="dto.ClienteId">
            <option value="0">-- Seleccione --</option>
            @foreach (var c in clientes)
            {
                <option value="@c.Id">@c.Nombre</option>
            }
        </InputSelect>
    </div>
    <div class="form-group">
        <label>Tipo Evento</label>
        <InputSelect class="form-select" @bind-Value="dto.TipoEvento">
            @foreach (var t in Enum.GetValues<TipoEvento>())
            {
                <option value="@t">@t</option>
            }
        </InputSelect>
    </div>
    <div class="form-group">
        <label>Fecha Evento</label>
        <InputDate class="form-control" @bind-Value="dto.FechaEvento" />
    </div>
    <div class="form-group">
        <label>Ubicacion</label>
        <InputText class="form-control" @bind-Value="dto.Ubicacion" />
    </div>
    <div class="form-group">
        <label>Num. Invitados</label>
        <InputNumber class="form-control" @bind-Value="dto.NumInvitados" />
    </div>
        <div class="form-group">
        <label>Estado</label>
        <InputSelect class="form-select" @bind-Value="dto.Estado">
            @foreach (var e in Enum.GetValues<EstadoEvento>())
            {
                <option value="@e">@e</option>
            }
        </InputSelect>
    </div>
    <br />
    <button type="button" class="btn btn-primary" @onclick="@Guardar">@TextoBoton</button>
    <a href="eventos" class="btn btn-secondary">Cancelar</a>
</EditForm>
</div>

@code {
    [Parameter]
    public int CodModificar { get; set; }

    private bool cargando;
    private EventoDTO dto = new() { FechaEvento = DateTime.Today };
    private List<ClienteDTO> clientes = new();
    private string Titulo = "Nuevo Evento";
    private string TextoBoton = "Guardar";
    private string? errorMensaje;

    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        StateHasChanged();
        try
        {
            try
            {
                var resultado = await ServCliente.Lista(1, 9999);
                clientes = resultado.Items;
            }
            catch (Exception ex)
            {
                errorMensaje = $"Error al cargar clientes: {ex.Message}";
                Notificacion.Mostrar($"Error al cargar clientes: {ex.Message}", ServicioNotificacion.Tipo.Error);
            }

            if (CodModificar > 0)
            {
                Titulo = "Modificar Evento";
                TextoBoton = "Modificar";
                try
                {
                    dto = await ServEvento.Buscar(CodModificar);
                }
                catch (Exception ex)
                {
                    errorMensaje = $"Error al cargar evento: {ex.Message}";
                    Notificacion.Mostrar($"Error al cargar evento: {ex.Message}", ServicioNotificacion.Tipo.Error);
                }
            }
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task Guardar()
    {
        cargando = true;
        StateHasChanged();
        errorMensaje = null;
        try
        {
            if (CodModificar > 0)
                await ServEvento.Modificar(CodModificar, dto);
            else
                await ServEvento.Guardar(dto);
            Notificacion.Mostrar("Guardado correctamente", ServicioNotificacion.Tipo.Exito);
            ServNav.NavigateTo("eventos");
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error: {ex.Message}";
            Notificacion.Mostrar($"Error: {ex.Message}", ServicioNotificacion.Tipo.Error);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
}
