@page "/eventos"
@inject ServicioEvento ServEvento
@inject NavigationManager ServNav

<PageTitle>Eventos</PageTitle>

<h3>Listado de Eventos</h3>

<p>
    <a href="evento" class="btn btn-primary">Agregar</a>
</p>

<table class="table" align="center" width="80%" border="1">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre Evento</th>
            <th>Tipo</th>
            <th>Cliente</th>
            <th>Fecha</th>
            <th>Ubicacion</th>
            <th>Invitados</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in lista)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.NombreEvento</td>
                <td>@item.TipoEvento</td>
                <td>@item.ClienteNombre</td>
                <td>@item.FechaEvento.ToShortDateString()</td>
                <td>@item.Ubicacion</td>
                <td>@item.NumInvitados</td>
                <td>
                    <a href="evento/@item.Id" class="btn btn-sm btn-warning">Modificar</a>
                    <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(item.Id)">Eliminar</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<EventoDTO> lista = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarLista();
    }

    private async Task CargarLista()
    {
        try
        {
            lista = await ServEvento.Lista();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task Eliminar(int Cod)
    {
        try
        {
            await ServEvento.Eliminar(Cod);
            await CargarLista();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}
