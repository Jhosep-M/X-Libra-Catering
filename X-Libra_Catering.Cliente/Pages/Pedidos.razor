@page "/pedidos"
@using X_Libra_Catering.Shared.Enums
@inject ServicioPedido ServPedido
@inject NavigationManager ServNav
@inject IJSRuntime JS

<PageTitle>Pedidos</PageTitle>

<div class="page-header">
    <div>
        <h3>Pedidos</h3>
        <p class="text-muted">Tablero de ordenes por estado</p>
    </div>
    <a href="pedido" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
        </svg>
        Agregar Pedido
    </a>
</div>

<div class="toolbar">
    <div class="search-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" class="search-input" placeholder="Buscar por evento..."
               @bind="filtroTexto" @bind:event="oninput" />
    </div>
    <span class="result-count">@pedidosFiltrados.Count() pedidos</span>
</div>

@if (!pedidosFiltrados.Any())
{
    <div class="empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/>
            <rect x="9" y="3" width="6" height="4" rx="1"/>
            <path d="M9 14l2 2 4-4"/>
        </svg>
        <h4>No hay pedidos registrados</h4>
        <p>Crea tu primer pedido para empezar.</p>
    </div>
}
else
{
    <div class="pedido-kanban">
        @foreach (var columna in columnas)
        {
            <div class="kanban-column"
                 @ondragover:preventDefault
                 @ondrop="e => SoltarEnColumna(e, columna.estado)">
                <div class="column-header">
                    <h4>@columna.titulo</h4>
                    <span class="column-count">@columna.pedidos.Count()</span>
                </div>
                <div class="column-body">
                    @foreach (var p in columna.pedidos)
                    {
                        <div class="pedido-card"
                             draggable="true"
                             @ondragstart="e => ArrastrarInicio(e, p)">
                            <h5>#@p.Id — @p.EventoNombre</h5>
                            <div class="pedido-meta">
                                <span>🚚 @(p.VehiculoPlaca ?? "Sin asignar")</span>
                                <span>📅 @p.FechaPedido.ToString("dd/MM/yyyy")</span>
                            </div>
                             <div class="pedido-total">@MonedaHelper.Formatear(p.Total)</div>
                             <div class="card-footer-actions">
                                 <button class="btn-icon btn-icon-qr" title="QR" @onclick="() => MostrarQr(p.Id)">
                                     <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                         <rect x="3" y="3" width="7" height="7"/>
                                         <rect x="14" y="3" width="7" height="7"/>
                                         <rect x="3" y="14" width="7" height="7"/>
                                         <path d="M18 14h3v3m-3 3h3v-3"/>
                                     </svg>
                                 </button>
                                 <a href="pedido/@p.Id" class="btn-icon btn-icon-edit" title="Editar">
                                     <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                         <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                         <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                     </svg>
                                 </a>
                                 <button class="btn-icon btn-icon-delete" title="Eliminar" @onclick="() => Eliminar(p.Id)">
                                     <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                         <polyline points="3 6 5 6 21 6"/>
                                         <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                     </svg>
                                 </button>
                             </div>
                         </div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (qrVisible)
{
    <div class="modal-overlay" @onclick="CerrarQr">
        <div class="modal-content modal-sm" @onclick:stopPropagation>
            <div class="modal-header">
                <h5>QR del Pedido #@qrPedidoId</h5>
                <button class="btn-close" @onclick="CerrarQr">&times;</button>
            </div>
            <div class="modal-body" style="text-align:center;">
                <img src="@($"{UrlHelper.Servidor}/api/Pedidos/Qr/{qrPedidoId}")" style="width:200px;height:200px;" />
            </div>
        </div>
    </div>
}

@code {
    private List<PedidoCabeceraDTO> lista = new();
    private string? filtroTexto;
    private PedidoCabeceraDTO? itemArrastrado;
    private bool qrVisible;
    private int qrPedidoId;

    private void MostrarQr(int id)
    {
        qrPedidoId = id;
        qrVisible = true;
    }

    private void CerrarQr()
    {
        qrVisible = false;
    }

    private record ColumnaPedidos(string titulo, EstadoPedido estado, IEnumerable<PedidoCabeceraDTO> pedidos);

    private IEnumerable<PedidoCabeceraDTO> pedidosFiltrados => lista
        .Where(p => string.IsNullOrWhiteSpace(filtroTexto) ||
                     (p.EventoNombre?.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ?? false));

    private List<ColumnaPedidos> columnas => new()
    {
        new ColumnaPedidos("Pendientes", EstadoPedido.Pendiente,
            pedidosFiltrados.Where(p => p.Estado == EstadoPedido.Pendiente).OrderByDescending(p => p.FechaPedido)),
        new ColumnaPedidos("En Preparacion", EstadoPedido.EnPreparacion,
            pedidosFiltrados.Where(p => p.Estado == EstadoPedido.EnPreparacion).OrderByDescending(p => p.FechaPedido)),
        new ColumnaPedidos("En Ruta", EstadoPedido.EnRuta,
            pedidosFiltrados.Where(p => p.Estado == EstadoPedido.EnRuta).OrderByDescending(p => p.FechaPedido)),
        new ColumnaPedidos("Entregados", EstadoPedido.Entregado,
            pedidosFiltrados.Where(p => p.Estado == EstadoPedido.Entregado).OrderByDescending(p => p.FechaPedido))
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try { lista = await ServPedido.Lista(); }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
    }

    private void ArrastrarInicio(DragEventArgs e, PedidoCabeceraDTO p)
    {
        itemArrastrado = p;
    }

    private async Task SoltarEnColumna(DragEventArgs e, EstadoPedido nuevoEstado)
    {
        if (itemArrastrado != null && itemArrastrado.Estado != nuevoEstado)
        {
            try
            {
                await ServPedido.CambiarEstado(itemArrastrado.Id, nuevoEstado);
                itemArrastrado.Estado = nuevoEstado;
                await CargarDatos();
            }
            catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
        }
        itemArrastrado = null;
    }

    private async Task Eliminar(int Cod)
    {
        try
        {
            await ServPedido.Eliminar(Cod);
            await CargarDatos();
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
    }
}
